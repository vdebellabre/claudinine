# .NET build output. The six release binaries are no longer committed: CI's
# matrix builds them and the release archive carries them. The hand-written
# routing shims live in eng/shims/, not here.
bin/
obj/
src/**/bin/
tests/**/bin/
*.user
.vs/
.idea/
publish/

# Plugin archives built by eng/pack-plugin.ps1; CI publishes them as release
# assets rather than committing them.
artifacts/

# Local benchmarking only, never committed. /bench/ holds a curated snapshot of
# real session transcripts (see eng/bench/README.md) — private conversation data
# that must never be committed or published. Leading slash so it matches only the
# repo-root corpus, NOT eng/bench/, which holds the curation tooling.
tests/POC reference/
/bench/

# Microsoft.Testing.Platform writes a per-run HTML report here.
TestResults/

# Python bytecode from eng/bench tooling.
__pycache__/
