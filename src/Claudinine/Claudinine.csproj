<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>claudinine</AssemblyName>
		<!-- No version here on develop: cd.yml writes the real one (see
		     eng/set-version.ps1) into the runner's checkout just before a
		     release is built, so `claudinine version` only ever reports a real
		     released number, never a stale in-source one. A build off develop
		     falls back to the SDK's own default (1.0.0.0). -->
		<RootNamespace>Claudinine</RootNamespace>

		<PublishAot>true</PublishAot>
		<StripSymbols>true</StripSymbols>
		<TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
		<OptimizationPreference>Size</OptimizationPreference>
		
		<InvariantGlobalization>true</InvariantGlobalization>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<!-- The pass is GC-bound, not CPU-bound: parsing a transcript allocates a
		     JsonNode graph per record, and workstation GC's small gen0 budget
		     collects constantly under that rate — server GC cut the corpus pass by
		     ~37% measured (eng/bench/profiling-notes.md). The cost is a larger
		     transient working set; fine for a process that lives well under a
		     second and exits. -->
		<ServerGarbageCollection>true</ServerGarbageCollection>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Claudinine.Tests" />
		<InternalsVisibleTo Include="Claudinine.Benchmarks" />
	</ItemGroup>

</Project>
