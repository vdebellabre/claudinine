<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>claudinine</AssemblyName>
		<Version>0.1.21</Version>
		<!-- No version here on develop: release builds get it as
		     -p:Version on the publish command line (build.yml), and cd.yml's
		     release commit writes it here via eng/set-version.ps1, so
		     `claudinine version` only ever reports a real released number,
		     never a stale in-source one. A build off develop falls back to
		     the SDK's own default (1.0.0.0). -->
		<RootNamespace>Claudinine</RootNamespace>

		<PublishAot>true</PublishAot>
		<StripSymbols>true</StripSymbols>
		<TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
		<!-- Explicit, because the ILCompiler default is NOT Size: measured on this
		     project, Size 3.06 MB / default 3.59 MB / Speed 3.79 MB, three distinct
		     binaries. All three are within noise of each other per invocation
		     (median 47-49 ms, agent tier), so this buys 531 KB against the default
		     for no measurable time cost. -->
		<OptimizationPreference>Size</OptimizationPreference>

		<InvariantGlobalization>true</InvariantGlobalization>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<!-- Workstation GC, deliberately, and NOT because the pass is cheap on
		     allocation — it is not. Server GC genuinely wins when many transcripts
		     are compacted inside one process (~26-30% off a full-corpus pass, p95
		     halved), which is how this was first measured.

		     But that is not how the plugin runs. Every hook event spawns a fresh
		     process that lives ~50 ms and exits, so server GC pays its heap setup
		     on every single invocation and exits before the larger gen0 budget can
		     repay it. Measured per-process on the corpus, workstation is ~15%
		     faster at the median in every size tier, large sessions included.

		     Do not "restore" server GC on the strength of a `run`/`bench` number:
		     those are in-process by construction and will always favour it. Only
		     the `aot` verb reproduces the shipped shape. Both sets of numbers, and
		     the method traps behind them, are in eng/bench/profiling-notes.md. -->
		<ServerGarbageCollection>false</ServerGarbageCollection>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Claudinine.Tests" />
		<InternalsVisibleTo Include="Claudinine.Benchmarks" />
	</ItemGroup>

</Project>
