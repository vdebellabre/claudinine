#!/bin/sh
# Platform-routing shim: picks the right Native AOT binary for this host.
# Windows never runs this file — cmd.exe resolves the extensionless path to
# claudinine.cmd via PATHEXT (dual-shim pattern).
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

case "$(uname -s)" in
  Darwin) os=osx ;;
  *)      os=linux ;;
esac

case "$(uname -m)" in
  arm64|aarch64) arch=arm64 ;;
  *)             arch=x64 ;;
esac

exec "$dir/$os-$arch/claudinine" "$@"
